{
  "name": "server",
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "cross-env NODE_ENV=production node dist/server.js",
    "start:staging": "cross-env NODE_ENV=staging node dist/server.js",
    "typecheck": "tsc -p ../tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose -f ../docker-compose.yaml up -d",
    "db:down": "docker compose -f ../docker-compose.yaml down",
    "db:logs": "docker compose -f ../docker-compose.yaml logs -f"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
